/***************************************************************************
    Windows resource script for CannonBall DX.

    This file is a template. CMake parses CANNONBALL_DX_VERSION from
    src/main/globals.hpp and configures this file into the build directory,
    so the version shown by Windows cannot drift from the version used by
    the game itself. Edit globals.hpp, not the generated .rc.
***************************************************************************/

#include <winver.h>

IDI_ICON1 ICON DISCARDABLE "@CB_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @CB_VERSION_MAJOR@,@CB_VERSION_MINOR@,@CB_VERSION_PATCH@,0
 PRODUCTVERSION @CB_VERSION_MAJOR@,@CB_VERSION_MINOR@,@CB_VERSION_PATCH@,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0409 = English (United States), 04B0 = Unicode (1200) */
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "CannonBall DX - enhanced OutRun engine for modern racing wheels and arcade cabinets"
            VALUE "FileVersion",      "@CB_VERSION_STRING@"
            VALUE "InternalName",     "cannonball-dx"
            VALUE "OriginalFilename", "cannonball-dx.exe"
            VALUE "ProductName",      "CannonBall DX"
            VALUE "ProductVersion",   "@CB_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
