<?xml version="1.0" encoding="utf-8"?>
<!-- Default config file for Cannonball-SE, a CannonBall fork by James Pearce. See https://github.com/J1mbo/cannonball -->
<!-- 
    Video Settings
-->
<video>
	<!-- Set Screen Mode:
         0 is windowed, 
         1 is full-screen
         2 is full-screen stretched, no borders. (Aspect ratio will be lost. Scanlines will be disabled.)
    Note: This build uses OpenGL-ES. Window mode may not be supported on all systems.
    -->
	<mode>1</mode>
	<!-- Window mode scale is the zoom factor for window mode, 1=original, 2=double etc -->
	<window>
		<scale>1</scale>
	</window>
	<!-- First-run video profile: original 4:3 aspect with all processing disabled. -->
	<widescreen>0</widescreen>
	<fps_counter>0</fps_counter>
	<vsync>0</vsync>
	<x_offset>0</x_offset>
	<y_offset>0</y_offset>
	<pixel_scaler>0</pixel_scaler>
	<shader_mode>0</shader_mode>
	<shadow_mask>0</shadow_mask>
	<maskDim>100</maskDim>
	<maskBoost>100</maskBoost>
	<scanlines>0</scanlines>
	<crt_shape>0</crt_shape>
	<vignette>0</vignette>
	<noise>0</noise>
	<warpX>0</warpX>
	<warpY>0</warpY>
	<desaturate>0</desaturate>
	<desaturate_edges>0</desaturate_edges>
	<brightboost>0</brightboost>
	<blargg>0</blargg>
	<saturation>0</saturation>
	<contrast>0</contrast>
	<brightness>0</brightness>
	<sharpness>0</sharpness>
	<resolution>0</resolution>
	<gamma>0</gamma>
	<hue>0</hue>
</video>
<!-- 
    Sound Settings
-->
<sound>
	<!-- Toggle Sound -->
	<enable>1</enable>
	<!-- Advertise Sound In Attract Mode -->
	<advertise>1</advertise>
	<!-- play music on music selection screen -->
	<preview>1</preview>
	<fix_samples>1</fix_samples>
	<playback_speed>125</playback_speed>
	<!-- Sample Rate:
	     The arcade ran at 31,250Hz (or possibly 15,625Hz). This build supports that, except if using custom music via mp3,
	     then 22050 or 44100 must be used. -->
	<rate>44100</rate>
	<!-- -1 uses the operating system's current default playback device. Set a specific SDL device index to override it. -->
	<playback_device>-1</playback_device>
	<!-- Callback Rate - either 0 (8ms) or 1 (16ms). 16ms will double the audio latency but may reduce dropouts on some systems. -->
	<callback_rate>0</callback_rate>
	<!-- Custom Music: Put .WAV, .MP3, or .YM files in res/ folder named as:
         [01–99]_Track_Display_Name.[wav|mp3|ym] - e.g. 04_AHA_Take_On_Me.mp3
         Indexes 01–03 will replace the built‑in tracks (01=Magical Sound Shower), higher indexes add tracks. -->
	<wave_volume>4</wave_volume>
</sound>
<!-- 
    Controls Settings
-->
<controls>
	<!-- First-run Xbox 360 / SDL GameController profile. The marker is converted
	     to normal persistent per-device bindings after SDL has initialized. -->
	<default_gamepad>1</default_gamepad>
	<!-- Gears:
        0 = Manual toggle
        1 = Manual hold
        2 = Manual separate Low / High buttons
        3 = Automatic
    -->
	<gear>2</gear>
	<!-- Keyboard Button Configuration. Easiest to configure with inbuilt menu. -->
	<keyconfig>
		<up>1073741906</up>
		<down>1073741905</down>
		<left>1073741904</left>
		<right>1073741903</right>
		<acc>97</acc>
		<brake>122</brake>
		<gear>32</gear>
		<start>115</start>
		<coin>99</coin>
		<menu>1073741886</menu>
		<gear1>103</gear1>
		<gear2>104</gear2>
		<view>118</view>
	</keyconfig>
	<!-- SDL GameController button numbers (Xbox layout):
         RB/LB are digital pedal fallbacks, A=Low, X=High, Y=View,
         B=Coin, Start=Start and Back=Menu. -->
	<padconfig>
		<acc>10</acc>
		<brake>9</brake>
		<gear>0</gear>
		<start>6</start>
		<coin>1</coin>
		<menu>4</menu>
		<gear1>0</gear1>
		<gear2>2</gear2>
		<view>3</view>
		<up>11</up>
		<down>12</down>
		<left>13</left>
		<right>14</right>
	</padconfig>
	<!-- Digital Controls: Steering Adjust Speed (1 to 9) -->
	<steerspeed>3</steerspeed>
	<!-- Digital Controls: Pedal Adjust Speed (1 to 9) -->
	<pedalspeed>4</pedalspeed>
	<!-- Analog Controls
         0 = Off
         1 = On
         2 = Wheel Only
    -->
	<analog enabled="1">
		<!-- Standard SDL GameController axes: Left X steering, RT gas, LT brake. -->
		<axis>
			<wheel>0</wheel>
			<accel invert="0">5</accel>
			<brake invert="0">4</brake>
		</axis>
		<!-- Analog Wheel Settings -->
		<wheel>
			<!-- Amount of wheel turning circle to use.
                 Example:  0 means use the entire wheel (this works best if haptic is enabled)
                 larger values mean to progressively use less of the wheel turning circle -->
			<zone>0</zone>
			<!-- Dead Zone In Centre Of Wheel. Total Wheel Range = 128
                 A Dead zone is useful if the centre accuracy of your wheel is poor.
                 A good Logitech Racing wheel should not need this -->
			<dead>0</dead>
		</wheel>
		<!-- Force Feedback / Haptic Support: disabled by default. Strength and
		     centering_strength remain the simple in-game controls. Every value in
		     effects/spring below is optional tuning; these defaults reproduce the
		     current CannonBall DX wheel feel exactly. No advanced-mode switch is
		     required. Higher values are allowed and will naturally clip at the
		     backend/wheel limit where necessary. -->
		<haptic enabled="0">
			<strength>50</strength>
			<centering_strength>30</centering_strength>
			<effects>
				<sand>4</sand>
				<tyre_slip>15</tyre_slip>
				<offroad_rumble_one_wheel>50</offroad_rumble_one_wheel>
				<offroad_rumble_full>100</offroad_rumble_full>
				<offroad_pull_one_wheel>43</offroad_pull_one_wheel>
				<offroad_pull_full>29</offroad_pull_full>
				<gear_shift>85</gear_shift>
				<music_selector>80</music_selector>
				<traffic_skid>100</traffic_skid>
				<crash_bump>100</crash_bump>
				<crash_spin_impact>100</crash_spin_impact>
				<crash_spin>115</crash_spin>
				<crash_flip_impact>100</crash_flip_impact>
				<crash_flip>115</crash_flip>
				<crash_flip_landing>100</crash_flip_landing>
				<start_steering>100</start_steering>
				<start_rev_shake>15</start_rev_shake>
			</effects>
			<spring>
				<!-- Percentages are relative to the normal Spring menu value. -->
				<low_speed>40</low_speed>
				<high_speed>100</high_speed>
				<sliding>67</sliding>
				<!-- Vehicle-speed points for the normal low -> high spring ramp. -->
				<speed_start>100</speed_start>
				<speed_full>240</speed_full>
				<!-- Temporary spring levels during loss-of-control states. -->
				<traffic_skid>50</traffic_skid>
				<crash_bump>65</crash_bump>
				<crash_spin>35</crash_spin>
				<crash_recovery>70</crash_recovery>
				<crash_flip_start>45</crash_flip_start>
				<crash_flip_airborne>10</crash_flip_airborne>
				<crash_flip_transition>25</crash_flip_transition>
				<crash_flip_landing>45</crash_flip_landing>
				<crash_flip_recovery>70</crash_flip_recovery>
			</spring>
		</haptic>
	</analog>
	<rumble>1.25</rumble>
</controls>
<!-- 
    Game Engine Settings
-->
<engine>
	<!-- Game Time: 
         0 = Easy      (80 seconds)
         1 = Normal    (75 seconds) 
         2 = Hard      (72 seconds) 
         3 = Very Hard (70 seconds) 
         4 = Infinite Time 
    -->
	<time>0</time>
	<!-- Traffic Difficulty: 
         0 = Easy, 
         1 = Normal, 
         2 = Hard, 
         3 = Very Hard 
         4 = No Traffic
    -->
	<traffic>1</traffic>
	<!-- The original Japanese release of OutRun featured slightly different
         tracks and course ordering. 
         
         Requires additional ROM files:
         epr-10380.133, epr-10382.118, epr-10381.132, epr-10383.117
         epr-10327.76,  epr-10329.58,  epr-10328.75,  epr-10330.57
    --->
	<japanese_tracks>0</japanese_tracks>
	<!-- Swap In Prototype Coconut Beach Track -->
	<prototype>0</prototype>
	<!-- Increase the number of allowed level objects. 
         This fixes the broken arches in Gateway for example.
    --->
	<levelobjects>1</levelobjects>
	<!-- Use the original random number generator seed to match the setup of
         the original game. Disable to use a truly random setup.
         This will affect initial traffic patterns in attract mode for example.
    -->
	<randomgen>1</randomgen>
	<!-- Fix minor bugs present in the original engine. -->
	<!-- Tile on music select screen, ms value at checkpoint etc. -->
	<fix_bugs>1</fix_bugs>
	<fix_timer>1</fix_timer>
	<new_attract>0</new_attract>
	<freeplay>1</freeplay>
	<offroad>0</offroad>
	<grippy_tyres>0</grippy_tyres>
	<bumper>0</bumper>
	<turbo>0</turbo>
	<car_color>0</car_color>
</engine>
<!-- Settings for Time Trial Mode -->
<time_trial>
	<!-- Default Number of Laps (1 - 5) -->
	<laps>3</laps>
	<!-- Default Amount of Traffic (0 - 8), where 0 is off -->
	<traffic>3</traffic>
</time_trial>
<!-- 
    Use the inbuilt menu system. 
    You can disable it and edit this config file instead if it makes more sense for your system.
 -->
<menu>
	<enabled>0</enabled>
	<roadspeed>25</roadspeed>
</menu>
<continuous>
	<traffic>1</traffic>
</continuous>