<Project>
  <!--
    Keep a normal Visual Studio/CMake Windows build runnable and distributable
    without manually collecting CannonBall DX runtime files afterwards.

    This deliberately copies only roms.txt from roms/. User-provided ROM data
    must never be bundled automatically.
  -->

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'cannonball-dx'">
    <CannonBallRes Include="$(MSBuildThisFileDirectory)res\**\*" />
    <CannonBallDocs Include="$(MSBuildThisFileDirectory)docs\**\*" />
    <CannonBallRootDocs Include="$(MSBuildThisFileDirectory)README.txt" />
  </ItemGroup>

  <Target Name="CannonBallDxAssembleRuntime"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'cannonball-dx' and '$(Configuration)' == 'Release'">
    <Message Text="Assembling CannonBall DX Windows runtime package in $(TargetDir)" Importance="high" />

    <!-- Remove repository-only files and old root-level resource copies left by
         earlier builds. This keeps incremental builds from preserving stale files. -->
    <Delete Files="$(TargetDir)README.md;$(TargetDir)CHANGELOG;$(TargetDir)CHANGELOG.md;$(TargetDir)EXTERNAL_OUTPUTS.md;$(TargetDir)tilemap.bin;$(TargetDir)tilepatch.bin" />

    <Copy SourceFiles="@(CannonBallRes)"
          DestinationFiles="@(CannonBallRes->'$(TargetDir)res\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(CannonBallDocs)"
          DestinationFiles="@(CannonBallDocs->'$(TargetDir)docs\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(CannonBallRootDocs)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />

    <MakeDir Directories="$(TargetDir)roms" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)roms\roms.txt"
          DestinationFolder="$(TargetDir)roms"
          SkipUnchangedFiles="true" />

    <!-- gamecontrollerdb.txt is required beside the executable. tilemap.bin and
         tilepatch.bin stay under res only. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)res\gamecontrollerdb.txt"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
